# ============================================================
# Clínica Oral Life – configuração Apache (hospedagens cPanel/Linux)
# Serve as páginas com URLs amigáveis (/implante-dentario em vez
# de /implante-dentario.html). Se a hospedagem for Netlify ou
# Vercel, este arquivo é ignorado: nessas plataformas as "pretty
# URLs" (/pagina para pagina.html) já funcionam por padrão.
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # URLs amigáveis: /tratamento -> /tratamento.html (sem alterar o endereço no navegador)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# HTTPS e "www" (remova o "#" e troque o domínio na publicação)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^(.*)$ https://www.orallife.com.br/$1 [R=301,L]
# </IfModule>

# Compressão (deixa o site mais rápido)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Cache do navegador para arquivos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Charset padrão
AddDefaultCharset UTF-8
